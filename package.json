{
  "name": "signalk-marinetraffic-public",
  "version": "0.1.1",
  "description": "SignalK plugin to grab data from Marine Traffic's public web site to signalk vessels",
  "main": "index.js",
  "signalk-plugin-enabled-by-default": true,
  "signalk": {
    "displayName": "MarineTraffic Public",
    "appIcon": "./icon.svg",
    "recommends": [
      "signalk-buddylist-plugin"
    ]
  },
  "scripts": {
    "test": "node --check index.js"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-ais"
  ],
  "author": {
    "name": "Chris Roberts",
    "email": "chris@problem-child.org"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@signalk/signalk-schema": "^1.0.3",
    "axios": "^1.13.2",
    "persistent-node-cache": "^1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/night199uk/signalk-marinetraffic-public.git"
  }
}
